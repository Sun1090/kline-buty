{
  "name": "kline-buty",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "audit:i18n": "node scripts/i18n-audit.mjs",
    "build": "tsc -b && vite build && npm run docs:build",
    "dev": "vite",
    "e2e": "playwright test",
    "lint": "eslint .",
    "perf": "vitest run --config vitest.perf.config.ts",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc -b --noEmit",
    "docs:prepare": "node scripts/docs-prepare.mjs",
    "docs:lint": "node scripts/kb-lint.mjs",
    "docs:anchor": "node scripts/kb-anchor-check.mjs",
    "docs:dev": "npm run docs:prepare && vitepress dev docs-site",
    "docs:build": "node scripts/docs-build.mjs",
    "precheck": "node scripts/precheck.mjs",
    "precheck:skip-build": "node scripts/precheck.mjs --skip-build",
    "bundle:report": "node scripts/bundle-report.mjs"
  },
  "dependencies": {
    "lightweight-charts": "^5.0.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "^10.9.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.5",
    "jsdom": "^30.0.1",
    "serve": "^14.2.6",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.68.0",
    "vite": "^8.2.2",
    "vitepress": "^1.6.4",
    "vitest": "^4.1.11"
  }
}
